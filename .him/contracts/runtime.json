{
  "schema_version": "1.0.0",
  "interface_id": "my-policy-v1",
  "description": "Minimal state-to-joint-position policy interface.",
  "transport": "stdio",
  "stateful": false,
  "lifecycle": {
    "health": "health",
    "metadata": "metadata",
    "reset": "reset",
    "infer": "infer",
    "close": "close"
  },
  "observations": [
    {
      "name": "robot.joint_position",
      "dtype": "float32",
      "shape": [22],
      "unit": "rad",
      "coordinate_frame": "robot",
      "encoding": null,
      "clock_domain": "control",
      "time_semantics": "sample_time",
      "optional": false,
      "normalization_ref": null,
      "description": "Current joint positions."
    }
  ],
  "actions": [
    {
      "name": "robot.desired_joint_position",
      "dtype": "float32",
      "shape": [22],
      "unit": "rad",
      "coordinate_frame": "robot",
      "encoding": null,
      "clock_domain": "control",
      "time_semantics": "command_time",
      "optional": false,
      "normalization_ref": null,
      "description": "Desired joint positions."
    }
  ],
  "auxiliary_outputs": [],
  "clock_domains": [
    {
      "id": "control",
      "trigger": "fixed_rate",
      "rate_hz": 50,
      "deadline_ms": 15,
      "hard_realtime": false,
      "placement": "same_host"
    }
  ],
  "batching": {
    "supported": false,
    "max_batch_size": 1,
    "max_wait_ms": 0
  },
  "error_model": {
    "retryable_codes": [],
    "terminal_codes": ["INVALID_OBSERVATION"],
    "fallback_action": "hold"
  },
  "extensions": {
    "template": true,
    "robot": {
      "model": "booster-k1-22dof",
      "source": "third_party/booster_assets/robots/K1/K1_22dof.urdf",
      "source_repo": "https://github.com/BoosterRobotics/booster_assets",
      "license": "BSD-3-Clause",
      "dof": 22,
      "joint_order": [
        "AAHead_yaw", "Head_pitch",
        "ALeft_Shoulder_Pitch", "Left_Shoulder_Roll", "Left_Elbow_Pitch", "Left_Elbow_Yaw",
        "ARight_Shoulder_Pitch", "Right_Shoulder_Roll", "Right_Elbow_Pitch", "Right_Elbow_Yaw",
        "Left_Hip_Pitch", "Left_Hip_Roll", "Left_Hip_Yaw", "Left_Knee_Pitch", "Left_Ankle_Pitch", "Left_Ankle_Roll",
        "Right_Hip_Pitch", "Right_Hip_Roll", "Right_Hip_Yaw", "Right_Knee_Pitch", "Right_Ankle_Pitch", "Right_Ankle_Roll"
      ],
      "notes": "Canonical 22-joint order + limits come from the public Booster K1 URDF, which matches HIM's Adam table-tennis fixture DOF (22). UNCONFIRMED against HIM's server-side evaluator: this contract keeps the single-policy template's signal names (robot.joint_position / robot.desired_joint_position) and 50 Hz control clock, whereas HIM's Adam robot manifest uses joint_positions / joint_targets at 60 Hz (and its dataset was captured at 100 Hz). Reconcile with HIM before deployment."
    }
  }
}
