{
  "schema_version": "1.0.0",
  "interface_id": "himrobot-g1-v1",
  "description": "State-to-joint-position policy interface for the Unitree G1 (29 DoF).",
  "transport": "stdio",
  "stateful": false,
  "lifecycle": {
    "health": "health",
    "metadata": "metadata",
    "reset": "reset",
    "infer": "infer",
    "close": "close"
  },
  "observations": [
    {
      "name": "robot.joint_position",
      "dtype": "float32",
      "shape": [
        29
      ],
      "unit": "rad",
      "coordinate_frame": "robot",
      "encoding": null,
      "clock_domain": "control",
      "time_semantics": "sample_time",
      "optional": false,
      "normalization_ref": null,
      "description": "Current joint positions."
    }
  ],
  "actions": [
    {
      "name": "robot.desired_joint_position",
      "dtype": "float32",
      "shape": [
        29
      ],
      "unit": "rad",
      "coordinate_frame": "robot",
      "encoding": null,
      "clock_domain": "control",
      "time_semantics": "command_time",
      "optional": false,
      "normalization_ref": null,
      "description": "Desired joint positions."
    }
  ],
  "auxiliary_outputs": [],
  "clock_domains": [
    {
      "id": "control",
      "trigger": "fixed_rate",
      "rate_hz": 50,
      "deadline_ms": 15,
      "hard_realtime": false,
      "placement": "same_host"
    }
  ],
  "batching": {
    "supported": false,
    "max_batch_size": 1,
    "max_wait_ms": 0
  },
  "error_model": {
    "retryable_codes": [],
    "terminal_codes": [
      "INVALID_OBSERVATION"
    ],
    "fallback_action": "hold"
  },
  "extensions": {
    "template": false,
    "robot": {
      "model": "unitree-g1-29dof",
      "source": "third_party/mujoco_menagerie/unitree_g1/g1.xml",
      "source_repo": "https://github.com/google-deepmind/mujoco_menagerie",
      "license": "BSD-3-Clause",
      "dof": 29,
      "joint_order": [
        "left_hip_pitch_joint",
        "left_hip_roll_joint",
        "left_hip_yaw_joint",
        "left_knee_joint",
        "left_ankle_pitch_joint",
        "left_ankle_roll_joint",
        "right_hip_pitch_joint",
        "right_hip_roll_joint",
        "right_hip_yaw_joint",
        "right_knee_joint",
        "right_ankle_pitch_joint",
        "right_ankle_roll_joint",
        "waist_yaw_joint",
        "waist_roll_joint",
        "waist_pitch_joint",
        "left_shoulder_pitch_joint",
        "left_shoulder_roll_joint",
        "left_shoulder_yaw_joint",
        "left_elbow_joint",
        "left_wrist_roll_joint",
        "left_wrist_pitch_joint",
        "left_wrist_yaw_joint",
        "right_shoulder_pitch_joint",
        "right_shoulder_roll_joint",
        "right_shoulder_yaw_joint",
        "right_elbow_joint",
        "right_wrist_roll_joint",
        "right_wrist_pitch_joint",
        "right_wrist_yaw_joint"
      ],
      "notes": "Joint order = MuJoCo Menagerie unitree_g1 actuator order, identical to the Unitree SDK2 G1JointIndex enum (tools/mocap/gmr_bvh_to_g1_headless.py writes the same order). UNCONFIRMED against HIM's server-side evaluator: signal names robot.joint_position / robot.desired_joint_position and the 50 Hz clock come from the HIM single-policy template; HIM's own G1 fixture (robot-unitree-g1-fixture) uses the same names at 50 Hz but is marked fixture-only with joint order not enumerated. Reconcile with HIM before deployment."
    }
  }
}
